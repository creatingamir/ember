fn main() {
    u8_max: u8 = 255
    u8_zero: u8 = 0
    u8_one: u8 = 1
    u8_two: u8 = 2
    u8_three: u8 = 3
    u8_seven: u8 = 7
    u8_half: u8 = 127
    print(u8_zero + u8_max)
    print(u8_max - u8_one)
    print(u8_max - u8_max)
    print(u8_zero - u8_zero)
    print(u8_max * u8_one)
    print(u8_zero * u8_max)
    print(u8_half * u8_two)
    print((u8_half + u8_half) + u8_one)
    print((u8_max - u8_half) - u8_half)
    print(u8_max / u8_two)
    print(u8_max / u8_max)
    print(u8_zero / u8_max)
    print(u8_max % u8_seven)
    print(u8_max % u8_two)
    print(u8_half % u8_three)
    print(u8_max / u8_three)
    print(u8_max > u8_zero)
    print(u8_zero < u8_max)
    print(u8_max >= u8_max)
    print(u8_zero <= u8_zero)
    print(u8_max == u8_max)
    print(u8_max != u8_zero)
    print(u8_half > u8_one)
    print(u8_one < u8_max)
}
