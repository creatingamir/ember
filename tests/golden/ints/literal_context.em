fn main() {
    a: u8 = 100
    print(a + 1)
    print(1 + a)
    print(a - 100)
    print(200 - a)
    print(a == 100)
    print(100 == a)
    print(a < 200)
    x: i16 = 1 + 2 * 3
    print(x)
    y := 3000000000 * 3
    print(y)
    z: i8 = -128
    print(z + 127)
    w: u32 = 4000000000 + 294967295
    print(w)
    n := -5
    print(n * 2)
}
